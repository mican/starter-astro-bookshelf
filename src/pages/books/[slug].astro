---

<Layout title={book.title}>
  <Header />
  <section
    class="px-2 sm:px-12 mb-8"
    transition:animate="slide"
    data-sb-object-id={book.id}
  >
    <h1 class="text-6xl" data-sb-field-path="title">
      {book.title}
    </h1>
    <h2 data-sb-field-path="author">
      written by <a href=`/author/${book.author.id}` data-sb-field-path=".name">{book.author.name}</a>
    </h2>
    <div
      class="grid grid-cols-1 gap-x-6 gap-y-10 lg:grid-cols-2 xl:gap-x-8 pt-8"
    >
      <div
        class="aspect-h-1 aspect-w-1 w-full overflow-hidden rounded-lg bg-gray-200 xl:aspect-h-8 xl:aspect-w-7"
      >
        <img
          data-sb-field-path="coverImage"
          src={book.coverImage.url}
          class="h-full w-full object-cover object-center group-hover:opacity-75"
        />
      </div>
      <div>
        <article
          data-sb-field-path="description"
          set:html={documentToHtmlString(book.description?.json)}
          class="leading-loose text-slate-200 text-justify"
        />
      </div>
    </div>
  </section>
</Layout>
